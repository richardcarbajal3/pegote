# Base de datos — Postgres (Neon en prod)
# Formato: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:pass@localhost:5432/pegote?schema=public"

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Google OAuth — sacar en https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URL pública (en prod: https://pegote.pe)
NEXTAUTH_URL="http://localhost:3000"
