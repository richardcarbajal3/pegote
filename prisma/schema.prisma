// PEGOTE — schema de base de datos
// Postgres (Neon en prod, Postgres local o Neon branch en dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH (Auth.js / NextAuth) =====

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  // Marketplace
  username      String?         @unique
  bio           String?
  isArtist      Boolean         @default(false)
  payoutInfo    String? // JSON: yape/plin/tarjeta
  createdAt     DateTime        @default(now())

  accounts      Account[]
  sessions      Session[]
  stickers      Sticker[]       @relation("StickerArtist")
  orders        Order[]         @relation("OrderBuyer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== MARKETPLACE =====

model Sticker {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  // Precio en céntimos de soles (S/ 8.00 = 800)
  priceCents  Int
  // Preview público (SVG/PNG)
  previewUrl  String
  // Archivo de descarga (alta resolución, sólo para compradores)
  fileUrl     String
  tags        String   @default("") // CSV simple
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  artistId    String
  artist      User     @relation("StickerArtist", fields: [artistId], references: [id], onDelete: Cascade)

  orderItems  OrderItem[]

  @@index([artistId])
  @@index([published])
}

model Order {
  id          String      @id @default(cuid())
  buyerId     String
  totalCents  Int
  status      String      @default("paid") // pending | paid | refunded
  paymentRef  String? // referencia de yape/plin/stripe
  createdAt   DateTime    @default(now())

  buyer       User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([buyerId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  stickerId  String
  priceCents Int // snapshot del precio al momento de la compra
  // 70% al artista, 30% a PEGOTE
  artistCut  Int
  platformCut Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id])

  @@index([orderId])
  @@index([stickerId])
}
